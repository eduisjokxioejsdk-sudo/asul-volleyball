# ---------------------------------------------------------------------------
# ASUL — configuration de production (Docker).
# Copier ce fichier à la RACINE du projet sous le nom « .env », puis ajuster.
#   cp deploy/env.production.example .env
# Le fichier « .env » est ignoré par git (secret).
# ---------------------------------------------------------------------------

# Domaine public. Son enregistrement DNS (A) doit pointer vers l'IP publique
# de la VM. Exemples : asul.tondomaine.fr, analyse.tondomaine.fr
ASUL_DOMAIN=asul.tondomaine.fr

# E-mail de contact pour Let's Encrypt (alertes d'expiration des certificats).
ACME_EMAIL=toi@exemple.com

# Secret de signature des tokens JWT — OBLIGATOIRE en production.
# Génère une longue chaîne aléatoire, par exemple :  openssl rand -hex 48
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# ---------------------------------------------------------------------------
# (Optionnel) Synchronisation cloud des équipes — Supabase (offre gratuite).
# Sans ces variables, les équipes restent stockées sur ce serveur uniquement.
# ---------------------------------------------------------------------------
# TEAMS_SYNC_PROVIDER=supabase
# TEAMS_SYNC_URL=https://xxxxxxxxxxxx.supabase.co
# TEAMS_SYNC_KEY=
# TEAMS_SYNC_TABLE=asul_teams
# TEAMS_SYNC_INTERVAL_MS=60000
