# -----------------------------------------------------------------------------
# ASUL Server - Variables d'environnement
# Copier ce fichier en `.env` (local) ou renseigner ces variables dans Railway.
# -----------------------------------------------------------------------------

# Port HTTP du serveur
PORT=3001

# Secret utilisé pour signer les tokens JWT (mettre une longue chaîne aléatoire)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Dossier de données (laisser vide en local ; Railway monte /data automatiquement)
# DATA_DIR=

# -----------------------------------------------------------------------------
# Cloudflare R2 (stockage des vidéos)
# Si ces 4 variables sont définies, les vidéos sont stockées dans R2.
# Sinon, elles restent sur le disque local (dossier server/uploads).
# -----------------------------------------------------------------------------

# ID du compte Cloudflare (visible dans l'URL du dashboard Cloudflare)
R2_ACCOUNT_ID=

# Clés d'accès S3 créées dans Cloudflare > R2 > "Manage API Tokens"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nom du bucket R2 (ex: asul-videos)
R2_BUCKET_NAME=

# (Optionnel) URL publique de lecture directe des vidéos, sans URL signée.
# 2 possibilités :
#   1. Custom domain connecté au bucket (recommandé) : https://videos.mondomaine.fr
#   2. Sous-domaine r2.dev : activer "Public access" sur le bucket, puis copier
#      l'URL du type https://pub-xxxxxxxxxxxx.r2.dev
# Si vide, le serveur génère des URLs signées temporaires (valables 1h) pour la lecture.
R2_PUBLIC_BASE_URL=
