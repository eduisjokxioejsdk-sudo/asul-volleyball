# -----------------------------------------------------------------------------
# ASUL Server - Variables d'environnement
# Copier ce fichier en `.env` et ajuster les valeurs au besoin.
# -----------------------------------------------------------------------------

# Port HTTP du serveur
PORT=3001

# Interface d'écoute. 0.0.0.0 = accessible aux autres postes du réseau local
# (indispensable pour le match en direct multi-appareils). 127.0.0.1 = local seul.
HOST=0.0.0.0

# Secret utilisé pour signer les tokens JWT (mettre une longue chaîne aléatoire).
# Facultatif : si absent, un secret unique au poste est généré et conservé dans
# le dossier de données.
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Dossier de données (base SQLite + vidéos). Laisser vide en local : le serveur
# utilise alors le dossier `server/`. L'application Windows définit cette
# variable automatiquement (%APPDATA%\ASUL\data).
# DATA_DIR=

# -----------------------------------------------------------------------------
# SYNCHRONISATION CLOUD DES ÉQUIPES (partage à distance — Supabase, gratuit)
# -----------------------------------------------------------------------------
# Facultatif : sans ces variables, les équipes restent stockées uniquement sur
# ce serveur (elles sont déjà partagées entre les appareils du réseau local).
#
# Sur un poste Windows (application installée), renseignez plutôt ces valeurs
# depuis l'onglet « Équipes » de l'interface : elles sont enregistrées dans
# %APPDATA%\ASUL\data\sync.json (voir SYNC.md). Les variables ci-dessous ont
# priorité et concernent le développement.
#
# TEAMS_SYNC_PROVIDER : supabase (seul fournisseur géré pour l'instant)
# TEAMS_SYNC_URL      : https://xxxxxxxxxxxx.supabase.co
# TEAMS_SYNC_KEY      : clé « anon » du projet (Settings > API)
# TEAMS_SYNC_TABLE    : nom de la table (défaut : asul_teams)
# TEAMS_SYNC_INTERVAL_MS : période de synchronisation (défaut 60000, min 15000)
# TEAMS_SYNC_ENABLED  : 0 pour désactiver malgré une configuration présente
# -----------------------------------------------------------------------------

TEAMS_SYNC_PROVIDER=supabase
TEAMS_SYNC_URL=
TEAMS_SYNC_KEY=
TEAMS_SYNC_TABLE=asul_teams
TEAMS_SYNC_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# FFMPEG (requis pour la découpe serveur et l'export par position)
# -----------------------------------------------------------------------------
# fluent-ffmpeg cherche d'abord cette variable, puis `ffmpeg` dans le PATH.
# En local Windows, pointez vers ffmpeg.exe, ex :
# FFMPEG_PATH=C:\chemin\vers\ffmpeg.exe
