# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
client/build/
.vite/

# Environment variables
.env
.env.*
!.env.example

# Database
*.db
*.sqlite
*.sqlite3
jwt-secret.key
server/jwt-secret.key
*.db-shm
*.db-wal
server/asul.db
server/asul.db-shm
server/asul.db-wal

# Uploads (keep folder, ignore files)
server/uploads/**
!server/uploads/.gitkeep

# Exports temporaires (clips MP4 du mode « Playlists »)
server/exports/
*.mp4
*.mov
*.avi
*.mkv
*.mpeg

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp

# Brouillons de travail (notes / plans internes, jamais versionnes)
.cline_texts.txt
.plan.txt

# Artefacts de build / fichiers générés (jamais versionnés)
client/public/viewer.html
desktop/dist-*/
desktop/ASUL-portable-*/
update-feed/
*.log

# Installeur Windows déposé à la racine du projet (envoi manuel, jamais versionné)
ASUL-Setup-*.exe
